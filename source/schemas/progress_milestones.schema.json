{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "progress_milestones/v1",
 "title": "Вехи страницы прогресса (Д38)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "milestones"
 ],
 "properties": {
  "schema": {
   "const": "progress_milestones/v1"
  },
  "milestones": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "date",
     "kind",
     "repos",
     "ru",
     "en",
     "evidence"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^M-\\d{2,}$"
     },
     "date": {
      "type": "string",
      "format": "date"
     },
     "kind": {
      "enum": [
       "decision",
       "verification",
       "device",
       "release",
       "start",
       "build",
       "world",
       "graphics",
       "process",
       "platform",
       "repository",
       "publishing",
       "structure"
      ]
     },
     "repos": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     },
     "fact": {
      "type": "string"
     },
     "order": {
      "type": "integer"
     },
     "ru": {
      "type": "string",
      "minLength": 10,
      "maxLength": 220
     },
     "en": {
      "type": "string",
      "minLength": 10,
      "maxLength": 220
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "kind",
        "source",
        "date",
        "verification"
       ],
       "properties": {
        "kind": {
         "enum": [
          "code",
          "doc",
          "decision",
          "measurement",
          "public_post",
          "platform_page"
         ]
        },
        "source": {
         "type": "string"
        },
        "ref": {
         "type": "string"
        },
        "date": {
         "type": "string",
         "format": "date"
        },
        "verification": {
         "enum": [
          "re-measured",
          "reported",
          "observed",
          "decision",
          "self-reported"
         ]
        }
       }
      }
     }
    }
   }
  }
 }
}
