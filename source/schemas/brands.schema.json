        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "PERSONAL",
              "PROJECT"
            ]
          },
          "project": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "tone": {
            "type": "string"
          },
          "visual": {
            "type": "string"
          },
          "topics_allowed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topics_forbidden": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cta": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "official_links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
