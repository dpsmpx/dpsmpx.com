{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "export_specs/v1",
  "title": "Требования экспорта площадок",
  "description": "data/platforms/export_specs.yaml — размеры, тип, вес и безопасные зоны форматов с источником и датой проверки (Д13).",
  "type": "object",
  "required": ["schema", "platform_languages", "formats"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "export_specs/v1"},
    "platform_languages": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"enum": ["ru", "en"]}, "minItems": 1}
    },
    "formats": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["platform", "width", "height", "file", "source", "source_class", "verified", "checked"],
        "additionalProperties": false,
        "properties": {
          "platform": {"type": "string"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "min_width": {"type": "integer", "minimum": 1},
          "max_bytes": {"type": "integer", "minimum": 1},
          "file": {"enum": ["png", "jpg"]},
          "safe_area": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false,
            "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "w": {"type": "integer", "minimum": 1}, "h": {"type": "integer", "minimum": 1}}
          },
          "purpose": {"type": "string"},
          "notes": {"type": "string"},
          "source": {"type": "string"},
          "source_class": {"enum": ["official", "primary_research", "professional", "community"]},
          "verified": {"type": "boolean"},
          "checked": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
