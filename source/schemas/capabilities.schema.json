                  "status"
                ],
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "api",
                      "restricted",
                      "own",
                      "manual",
                      "no"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "limits": {
            "type": "object"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
