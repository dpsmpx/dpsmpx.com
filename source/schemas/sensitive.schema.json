{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensitive/v1",
  "title": "Фильтр чувствительных данных",
  "description": "data/policy/sensitive.yaml (Д39) — что не должно выйти наружу через сайт; код — tools/cs/core/sensitive.py.",
  "type": "object",
  "required": ["schema", "rules", "terms", "allow"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "sensitive/v1"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "basis", "where", "show", "pattern"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^SD-[A-Z0-9-]+$"},
          "label": {"type": "string", "minLength": 1},
          "basis": {"type": "string", "minLength": 1},
          "where": {"enum": ["raw", "text"]},
          "show": {"type": "boolean"},
          "pattern": {"type": "string", "minLength": 1}
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "label", "basis"],
        "additionalProperties": false,
        "properties": {
          "term": {"type": "string", "minLength": 3},
          "label": {"type": "string"},
          "basis": {"type": "string"}
        }
      }
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "value", "reason"],
        "additionalProperties": false,
        "properties": {
          "rule": {"type": "string", "pattern": "^SD-[A-Z0-9-]+$"},
          "value": {"type": "string"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
